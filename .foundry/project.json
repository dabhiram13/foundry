{
  "name": "Foundry",
  "checks": [
    {
      "name": "runtime",
      "command": ["npm", "run", "check:runtime"],
      "cwd": ".",
      "timeout": 420,
      "required": true,
      "inputs": ["src", "tests/runtime", "scripts/build_runtime.mjs", "tsconfig.runtime.json", ".foundry/roles.json", "package.json", "package-lock.json"]
    },
    {
      "name": "static-site",
      "command": ["npm", "run", "check:site"],
      "cwd": ".",
      "timeout": 240,
      "required": true,
      "inputs": ["site/src", "site/assets", "site/astro.config.mjs", "site/content-map.mjs", "site/remark-links.mjs", "site/remark-tables.mjs", "docs", "scripts/prepare_site.mjs", "tests/site.test.mjs", "tsconfig.json", "README.md", "CONTRIBUTING.md", "SECURITY.md", "THIRD_PARTY_NOTICES.md", "package.json", "package-lock.json"]
    },
    {
      "name": "tooling",
      "command": ["node", "--test", "tests/tooling.test.mjs"],
      "cwd": ".",
      "timeout": 120,
      "required": true,
      "inputs": ["scripts/check_catalog.mjs", "scripts/security_scan.mjs", "tests/tooling.test.mjs", "package.json", "package-lock.json"]
    },
    {
      "name": "catalog",
      "command": ["node", "scripts/check_catalog.mjs"],
      "cwd": ".",
      "timeout": 120,
      "required": true,
      "inputs": [".agents", ".codex", ".foundry/roles.json", ".foundry/workflows", ".foundry/references", "library", "skills", "scripts/check_catalog.mjs"]
    },
    {
      "name": "secrets",
      "command": ["node", "scripts/security_scan.mjs", "--whole-tracked"],
      "cwd": ".",
      "timeout": 120,
      "required": true,
      "inputs": ["scripts/security_scan.mjs", ".githooks/pre-commit"]
    }
  ]
}
