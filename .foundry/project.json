{
  "name": "Product Foundry",
  "checks": [
    {"name": "behavior", "command": ["python3", "-m", "unittest", "discover", "-s", "tests", "-v"], "cwd": ".", "timeout": 180, "required": true},
    {"name": "catalog", "command": ["python3", "scripts/check_catalog.py"], "cwd": ".", "timeout": 120, "required": true},
    {"name": "web-app", "command": ["python3", "-m", "unittest", "test_app", "-v"], "cwd": "tests/fixtures/web_app", "timeout": 60, "required": true},
    {"name": "secrets", "command": ["python3", "scripts/security_scan.py", "--whole-tracked"], "cwd": ".", "timeout": 120, "required": true}
  ]
}
