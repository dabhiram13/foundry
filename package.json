{
  "name": "foundry-evaluation",
  "version": "0.2.0",
  "private": true,
  "description": "Pinned factory plugin panel build and browser verification tools",
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@openai/mcp-extensions": "0.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "cookie": "2.0.1",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:panel": "python3 scripts/build_panel.py",
    "typecheck:runtime": "tsc --project tsconfig.runtime.json --noEmit",
    "build:runtime": "node scripts/build_runtime.mjs",
    "test:runtime": "node --test dist/runtime-tests/*.test.cjs",
    "build:site": "node scripts/prepare_site.mjs && astro build --root site",
    "preview:site": "astro preview --root site --host 127.0.0.1",
    "test:site": "node --test tests/site.test.mjs",
    "test:docs-browser": "node tests/docs_browser.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/manrope": "5.2.6",
    "@fontsource/figtree": "5.3.0",
    "bot-avatars": "0.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "get-nonce": "1.0.1",
    "lucide-react": "1.51.0",
    "marked": "18.0.14",
    "motion": "12.23.24",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  }
}
