{
  "name": "@dabhiram13/foundry",
  "version": "0.2.0",
  "private": true,
  "description": "A terminal-first Foundry runtime for Node 24",
  "bin": {
    "foundry": "dist/runtime/foundry.cjs"
  },
  "files": [
    "dist/runtime/foundry.cjs",
    "dist/runtime/foundry-worker.cjs",
    ".foundry/roles.json",
    "!.foundry/THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "@iarna/toml": "2.2.5",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/manrope": "5.2.6",
    "@fontsource/figtree": "5.3.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/mcp-extensions": "0.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "bot-avatars": "0.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie": "2.0.1",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "get-nonce": "1.0.1",
    "lucide-react": "1.51.0",
    "marked": "18.0.14",
    "motion": "12.23.24",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node dist/runtime/foundry.cjs",
    "build": "npm run build:runtime && npm run build:site",
    "typecheck": "npm run typecheck:runtime && npm run typecheck:site",
    "test": "npm run build && npm run test:runtime && npm run test:site && npm run test:pack",
    "build:panel": "python3 scripts/build_panel.py",
    "typecheck:runtime": "tsc --project tsconfig.runtime.json --noEmit",
    "build:runtime": "node scripts/build_runtime.mjs",
    "test:runtime": "node --test --test-name-pattern='^(?=.*\\s)(?!.*(?:service-created workspace shares Research|loopback HTTP requires|HTTP runs in the background|stdio MCP subprocess|documentation routing and CSP|Python and TypeScript installers)).*$' dist/runtime-tests/*.test.cjs",
    "typecheck:site": "astro sync --root site",
    "build:site": "node scripts/prepare_site.mjs && astro build --root site",
    "preview:site": "astro preview --root site --host 127.0.0.1",
    "test:site": "node --test tests/site.test.mjs",
    "test:pack": "node --test tests/runtime/package.test.mjs",
    "test:docs-browser": "node tests/docs_browser.cjs"
  }
}
