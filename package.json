{
  "name": "@dabhiram13/foundry",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabhiram13/foundry.git"
  },
  "homepage": "https://foundry-two-tan.vercel.app/",
  "bugs": "https://github.com/dabhiram13/foundry/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Build software from your terminal. Plan, write code and run checks with Foundry.",
  "bin": {
    "foundry": "dist/runtime/foundry.cjs"
  },
  "files": [
    "dist/runtime/foundry.cjs",
    "dist/runtime/foundry-worker.cjs",
    ".foundry/LICENSE-framework",
    ".foundry/roles.json",
    ".foundry/THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/Zod-MIT.txt",
    "licenses/parse5-MIT.txt",
    "licenses/entities-BSD.txt",
    "README.md"
  ],
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "@iarna/toml": "2.2.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.51.0",
    "motion": "12.23.24",
    "parse5": "8.0.1",
    "postcss": "8.5.28",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "@expressive-code/core": {
      "postcss-nested": "7.0.2"
    }
  },
  "scripts": {
    "prepack": "npm run build:runtime",
    "prepublishOnly": "npm test",
    "start": "node dist/runtime/foundry.cjs",
    "build": "npm run build:runtime && npm run build:site",
    "typecheck": "npm run typecheck:runtime && npm run typecheck:site",
    "test": "npm run check:runtime && npm run check:site && node --test tests/tooling.test.mjs && node scripts/check_catalog.mjs && node scripts/security_scan.mjs --whole-tracked",
    "check:runtime": "npm run typecheck:runtime && npm run build:runtime && npm run test:runtime && npm run test:pack",
    "check:site": "npm run typecheck:site && npm run build:site && npm run test:site",
    "typecheck:runtime": "tsc --project tsconfig.runtime.json --noEmit",
    "build:runtime": "node scripts/build_runtime.mjs",
    "test:runtime": "node --test dist/runtime-tests/*.test.cjs",
    "typecheck:site": "tsc --project tsconfig.json --noEmit && astro sync --root site",
    "build:site": "node scripts/prepare_site.mjs && astro build --root site",
    "preview:site": "astro preview --root site --host 127.0.0.1",
    "test:site": "node --test tests/site.test.mjs",
    "test:pack": "node --test tests/runtime/package.test.mjs"
  }
}
