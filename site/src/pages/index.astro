---
import landing from '../../.generated/landing.html?raw';
const title = 'Foundry - Build your idea. Keep control.';
const description = 'Plan the work. Build with your coding tool. Review every change. Foundry keeps progress, approvals and checks connected.';
const canonical = new URL('/', Astro.site).href;
const shareImage = new URL('/assets/foundry-share.png', Astro.site).href;
const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Foundry',
  url: canonical,
  description,
  applicationCategory: 'DeveloperApplication',
  softwareRequirements: 'Node.js 24 or newer, npm and Git',
  license: 'https://opensource.org/license/mit',
  downloadUrl: 'https://www.npmjs.com/package/@dabhiram13/foundry',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Foundry horse mark and wordmark on a warm background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify(application)} />
    <link rel="icon" href="/assets/foundry-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/style.css" />
    <script is:inline>try { const mode = localStorage.getItem('starlight-theme'); document.documentElement.dataset.theme = mode === 'dark' || mode === 'light' ? mode : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch { /* The page remains usable without storage. */ }</script>
    <script is:inline src="/public.js" defer></script>
  </head>
  <body><div id="foundry-public" set:html={landing} /></body>
</html>
