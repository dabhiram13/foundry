---
import landing from '../../.generated/landing.html?raw';
const title = 'Foundry - Make something worth shipping';
const description = 'Research, plan, design, build and review software with Foundry. Save progress and use your coding tool or a provider you choose.';
const canonical = new URL('/', Astro.site).href;
const shareImage = new URL('/assets/foundry-share.png', Astro.site).href;
const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Foundry',
  url: canonical,
  description,
  applicationCategory: 'DeveloperApplication',
  softwareRequirements: 'Node.js 24 or newer, npm and Git',
  license: 'https://opensource.org/license/mit',
  downloadUrl: 'https://www.npmjs.com/package/@dabhiram13/foundry',
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101015" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Foundry. A clear path from idea to product. The horse mark and Foundry name on a neutral background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <script type="application/ld+json" set:html={JSON.stringify(application)} />
    <link rel="icon" href="/assets/foundry-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/style.css" />
    <script is:inline src="/public.js" type="module"></script>
  </head>
  <body><div id="foundry-public" set:html={landing} /></body>
</html>
